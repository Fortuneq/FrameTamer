# MyDescript Backend – environment configuration example
# Copy this file to .env and fill in the values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Claude AI (required for AI features)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Whisper model selection
# Options: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v3

# Device: auto | cpu | cuda
WHISPER_DEVICE=auto

# Compute type: auto | float32 | float16 | int8
WHISPER_COMPUTE_TYPE=auto

# Storage (defaults to ~/ClipForge/...)
# PROJECTS_DIR=/Users/me/ClipForge/projects
# MEDIA_DIR=/Users/me/ClipForge/media
# TEMP_DIR=/Users/me/ClipForge/temp
